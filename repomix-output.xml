        <div class="exam-score-banner" id="examScoreBanner"></div>
        <div class="exam-feedback-panel" id="examFeedbackPanel" style="display:none;">
          <div class="fb-title">WHERE TO FOCUS</div>
          <div class="fb-body" id="examFeedbackBody"></div>
        </div>
        <div class="exam-questions" id="examResultsList"></div>
        <div class="study-controls">
          <span></span>
          <button class="btn btn-primary" id="examCloseResultsBtn">Done</button>
        </div>
      </div>
    </div>
  </div>

  <!-- STUDY MODE OVERLAY -->
  <div class="overlay" id="studyOverlay">
    <div class="study-container">
      <div class="study-header">
        <span id="studyDeckTitle" class="mono">DECK NAME</span>
        <span id="studyScore" class="stamp mono">0 right · 0 wrong</span>
        <span id="studyDueStamp" class="stamp mono" title="Cards due for review today">0 due</span>
        <span id="studyProgress" class="stamp mono">1 / 10</span>
        <button class="icon-btn" id="closeStudyBtn" title="Close">✕</button>
      </div>

      <div class="study-card-wrapper">
        <div class="card-flip study-card-flip" id="studyCardFlip">
          <div class="card-inner">
            <div class="card-face card-front">
              <div class="tag">QUESTION</div>
              <div class="body" id="studyFrontText"></div>
            </div>
            <div class="card-face card-back">
              <div class="tag">ANSWER</div>
              <div class="body" id="studyBackText"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="study-answer-row" id="studyAnswerRow">
        <input type="text" id="studyAnswerInput" placeholder="Type your answer, then check it…" autocomplete="off">
        <button class="btn btn-primary" id="studyCheckBtn">Check</button>
      </div>
      <div class="study-verdict" id="studyVerdict"></div>

      <!-- Self-rating row: how well did you recall this card? Shown once
           flipped to the answer side. Feeds the spaced-repetition
           scheduler (js/srs.js) — separate from the typed-answer AI
           check above, since flipping through cards with no typed
           answer would otherwise give the scheduler no signal at all. -->
      <div class="srs-rate-row" id="srsRateRow" style="display:none;">
        <div class="srs-rate-label">How well did you know this?</div>
        <div class="srs-rate-btns">
          <button class="srs-rate-btn srs-again" data-rating="0">Again</button>
          <button class="srs-rate-btn srs-hard" data-rating="1">Hard</button>
          <button class="srs-rate-btn srs-good" data-rating="2">Good</button>
          <button class="srs-rate-btn srs-easy" data-rating="3">Easy</button>
        </div>
      </div>

      <div class="study-controls">
        <button class="btn btn-ghost" id="studyPrevBtn">← Previous</button>
        <button class="btn btn-primary" id="studyFlipBtn">Flip Card (Space)</button>
        <button class="btn btn-ghost" id="studyNextBtn">Next →</button>
      </div>
    </div>

  </div>

  <!-- MAKER QUIZ OVERLAY (one question at a time) -->
  <div class="overlay" id="makerQuizOverlay">
    <div class="study-container">
      <div class="study-header">
        <span id="makerQuizTitle" class="mono">MOCK QUIZ</span>
        <span id="makerQuizScore" class="stamp mono">0 right · 0 wrong</span>
        <span id="makerQuizProgress" class="stamp mono">1 / 10</span>
        <button class="icon-btn" id="closeMakerQuizBtn" title="Close">✕</button>
      </div>

      <div class="qtype-tag" id="makerQuizQTypeTag">MULTIPLE CHOICE</div>
      <div class="quiz-question-box">
        <div class="tag">QUESTION</div>
        <div class="body" id="makerQuizQuestionText"></div>
      </div>

      <div class="quiz-options" id="makerQuizOptions"></div>
      <div id="makerQuizIdWrap" style="display:none;">
        <div class="study-answer-row">
          <input type="text" id="makerQuizIdInput" placeholder="Type your answer, then check it…" autocomplete="off">
          <button class="btn btn-primary" id="makerQuizIdCheckBtn">Check</button>
        </div>
      </div>

      <div class="hint-row">
        <button class="ask-tutor-btn" id="makerQuizAskTutorBtn">🏛️ Ask the tutor</button>
        <button class="hint-btn" id="makerQuizHintBtn">💡 Get a hint</button>
      </div>
      <div class="hint-box" id="makerQuizHintBox"></div>

      <div class="study-verdict" id="makerQuizVerdict"></div>

      <div class="study-controls">
        <span></span>
        <button class="btn btn-primary" id="makerQuizNextBtn" disabled>Next →</button>
      </div>
    </div>
  </div>

  <!-- MAKER EXAM OVERLAY (all at once, timed) -->
  <div class="overlay" id="makerExamOverlay">
    <div class="study-container" style="max-width:780px;">
      <div class="study-header">
        <span id="makerExamTitle" class="mono">MOCK EXAM</span>
        <span id="makerExamTimer" class="stamp mono">00:00</span>
        <button class="icon-btn" id="closeMakerExamBtn" title="Close">✕</button>
      </div>

      <div id="makerExamIntro" class="exam-intro">
        <p id="makerExamIntroText">This exam has questions built from your topic and materials. Answer each one, then submit at the end to see your full results with feedback.</p>
        <button class="btn btn-primary" id="makerExamStartBtn" style="width:100%; padding:13px;">Start Exam</button>
      </div>

      <div id="makerExamBody" style="display:none;">
        <div class="exam-questions" id="makerExamQuestions"></div>
        <div class="study-controls">
          <span class="mono" id="makerExamAnsweredCount" style="color:var(--ink-soft); font-size:12.5px;"></span>
          <button class="btn btn-primary" id="makerExamSubmitBtn">Submit Exam</button>
        </div>
      </div>

      <div id="makerExamResults" style="display:none;">
        <div class="exam-score-banner" id="makerExamScoreBanner"></div>
        <div class="exam-feedback-panel" id="makerExamFeedbackPanel" style="display:none;">
          <div class="fb-title">WHERE TO FOCUS</div>
          <div class="fb-body" id="makerExamFeedbackBody"></div>
        </div>
        <div class="exam-questions" id="makerExamResultsList"></div>
        <div class="study-controls">
          <span></span>
          <button class="btn btn-primary" id="makerExamCloseResultsBtn">Done</button>
        </div>
      </div>
    </div>
  </div>

  <!-- FLOATING "ASK THE TUTOR" BUTTON (shown while inside a maker quiz/exam) -->
  <button class="float-tutor-fab" id="floatTutorFab">🏛️ Ask the Tutor</button>

  <!-- FLOATING "ASK ABOUT THIS VIDEO" BUTTON (shown only while on the Watch tab) -->
  <button class="float-tutor-fab" id="watchTutorFab" style="bottom: 96px;">🏛️ Ask about this video</button>

  <!-- WATCH TUTOR DRAWER (Socratic help scoped to whatever video is currently loaded) -->
  <div class="side-tutor-drawer" id="watchTutorDrawer">
    <div class="side-tutor-header">
      <h4>🏛️ Ask about this video</h4>
      <button class="icon-btn" id="closeWatchTutorBtn" title="Close">✕</button>
    </div>
    <div class="side-tutor-chat" id="watchTutorChat"></div>
    <div class="side-tutor-composer">
      <textarea id="watchTutorInput" placeholder="Ask what's confusing you…"></textarea>
      <button class="btn btn-primary" id="watchTutorSendBtn">Send</button>
    </div>
  </div>

  <!-- FLOATING POMODORO WIDGET (available from any view) -->
  <div class="pomodoro-widget" id="pomodoroWidget" data-phase="work">
    <button class="pomodoro-pill" id="pomodoroExpandBtn" title="Expand timer">
      <span id="pomodoroPillTime">25:00</span>
    </button>
    <div class="pomodoro-card">
      <div class="pomodoro-card-top">
        <span class="pomodoro-phase-label" id="pomodoroPhaseLabel">Focus</span>
        <div style="display:flex; gap:4px;">
          <button class="icon-btn" id="pomodoroSettingsBtn" title="Timer settings">⚙</button>
          <button class="icon-btn" id="pomodoroMinimizeBtn" title="Minimize">–</button>
        </div>
      </div>

      <div class="pomodoro-ring" id="pomodoroRing" style="--pomodoro-pct: 0;">
        <span class="pomodoro-time mono" id="pomodoroTime">25:00</span>
      </div>

      <div class="pomodoro-dots" id="pomodoroDots"></div>

      <div class="pomodoro-controls">
        <button class="icon-btn" id="pomodoroResetBtn" title="Reset this phase">↺</button>
        <button class="btn btn-primary pomodoro-play-btn" id="pomodoroPlayPauseBtn" title="Start">▶</button>
        <button class="icon-btn" id="pomodoroSkipBtn" title="Skip to next phase">⏭</button>
      </div>

      <div class="pomodoro-phase-banner" id="pomodoroPhaseBanner"></div>
    </div>
  </div>

  <!-- POMODORO SETTINGS POPOVER -->
  <div class="overlay" id="pomodoroSettingsPopover">
    <div class="modal" style="max-width:360px;">
      <h3>Timer Settings</h3>
      <div class="sub">Durations are in minutes.</div>

      <div class="field">
        <label for="pomodoroWorkMinsInput">Focus session</label>
        <input type="number" id="pomodoroWorkMinsInput" min="1" max="180" value="25">
      </div>
      <div class="field">
        <label for="pomodoroShortBreakMinsInput">Short break</label>
        <input type="number" id="pomodoroShortBreakMinsInput" min="1" max="180" value="5">
      </div>
      <div class="field">
        <label for="pomodoroLongBreakMinsInput">Long break</label>
        <input type="number" id="pomodoroLongBreakMinsInput" min="1" max="180" value="15">
      </div>
      <div class="field">
        <label for="pomodoroCyclesInput">Focus sessions before a long break</label>
        <input type="number" id="pomodoroCyclesInput" min="1" max="12" value="4">
      </div>
      <div class="field">
        <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
          <input type="checkbox" id="pomodoroSoundToggle" style="width:auto;" checked>
          Play a chime when a phase ends
        </label>
      </div>

      <div class="modal-actions">
        <button class="btn btn-ghost" id="pomodoroSettingsCancelBtn">Cancel</button>
        <button class="btn btn-primary" id="pomodoroSettingsSaveBtn">Save</button>
      </div>
    </div>
  </div>

  <!-- SIDE TUTOR DRAWER (Socratic help, reachable from inside quiz/exam) -->
  <div class="side-tutor-drawer" id="sideTutorDrawer">
    <div class="side-tutor-header">
      <h4>🏛️ Socratic Tutor</h4>
      <button class="icon-btn" id="closeSideTutorBtn" title="Close">✕</button>
    </div>
    <div class="side-tutor-chat" id="sideTutorChat"></div>
    <div class="side-tutor-composer">
      <textarea id="sideTutorInput" placeholder="Ask about this question…"></textarea>
      <button class="btn btn-primary" id="sideTutorSendBtn">Send</button>
    </div>
  </div>

  <!-- EXPORT DECK MODAL -->
  <div class="overlay" id="exportDeckOverlay">
    <div class="modal" style="max-width:420px;">
      <h3>Export Deck</h3>
      <div class="sub">Export "<span id="exportDeckName"></span>" for use outside StudyStudio.</div>
      <div class="modal-actions" style="flex-direction:column; align-items:stretch; gap:10px; margin-top:16px;">
        <button class="btn btn-primary" type="button" id="exportDeckAnkiBtn" style="width:100%;">⬇ Export for Anki (.txt)</button>
        <div class="hint-text" style="margin:-4px 0 4px;">Import in Anki desktop via File → Import, "Fields separated by: Tab".</div>
        <button class="btn btn-ghost" type="button" id="exportDeckCsvBtn" style="width:100%;">⬇ Export as CSV</button>
        <div class="hint-text" style="margin:-4px 0 4px;">Opens in Excel/Sheets, or import into most other flashcard apps.</div>
      </div>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="exportDeckCancelBtn">Close</button>
      </div>
    </div>
  </div>

  <!-- SCORE HISTORY MODAL -->
  <div class="overlay" id="scoreHistoryOverlay">
    <div class="modal" style="max-width:560px;">
      <h3 id="scoreHistoryTitle">Quiz & Exam History</h3>
      <div class="sub">Every graded quiz/exam attempt, most recent first.</div>
      <div id="scoreHistoryList" style="max-height:50vh; overflow-y:auto; margin-top:10px;"></div>
      <div class="empty" id="scoreHistoryEmpty" style="display:none; padding:20px 8px;">
        <p style="margin-bottom:0; font-size:13px;">No attempts logged yet — take a quiz or exam to start tracking progress.</p>
      </div>
      <div class="modal-actions">
        <button class="link-danger" id="scoreHistoryClearBtn">Clear history</button>
        <button class="btn btn-ghost" id="closeScoreHistoryBtn">Close</button>
      </div>
    </div>
  </div>

  <!-- SETTINGS MODAL -->
  <div class="overlay" id="settingsOverlay">
    <div class="modal">
      <h3>Settings</h3>
      <div class="sub">Your API key is stored locally in your browser.</div>
      <div class="field">
        <label for="providerSelect">AI Provider</label>
        <select id="providerSelect">
          <option value="gemini">Google Gemini</option>
          <option value="groq">Groq</option>
        </select>
        <div class="note">Pick which provider to use. Each has its own API key and model list below.</div>
      </div>

      <div class="field" id="geminiFields">
        <label for="apiKeyInputGemini">Gemini API Key</label>
        <input type="password" id="apiKeyInputGemini" placeholder="Paste your Gemini API key">
        <div class="note">Get a free key at <a href="https://aistudio.google.com/apikey" target="_blank"
            rel="noopener">aistudio.google.com/apikey</a></div>
        <label for="geminiModelSelect" style="margin-top:12px;">Model</label>
        <select id="geminiModelSelect">
          <option value="gemini-3.6-flash">Gemini 3.6 Flash (Free, Recommended)</option>
        </select>
        <div class="note" id="geminiQuotaNote" style="margin-top:8px;"></div>
      </div>

      <div class="field" id="groqFields" style="display:none;">
        <label for="apiKeyInputGroq">Groq API Key</label>
        <input type="password" id="apiKeyInputGroq" placeholder="Paste your Groq API key">
        <div class="note">Get a free key at <a href="https://console.groq.com/keys" target="_blank"
            rel="noopener">console.groq.com/keys</a></div>
        <label for="groqModelSelect" style="margin-top:12px;">Model</label>
        <select id="groqModelSelect">
          <option value="openai/gpt-oss-120b">GPT-OSS 120B (Recommended)</option>
          <option value="openai/gpt-oss-20b">GPT-OSS 20B (Faster)</option>
          <option value="qwen/qwen3.6-27b">Qwen 3.6 27B (Vision + JSON mode)</option>
        </select>
        <div class="note">Image/PDF attachments (Socratic tutor photo, mock test files) require a vision-capable
          model like Qwen 3.6 27B — other Groq models will ignore attached images.</div>
      </div>

      <div class="field">
        <label>Appearance</label>
        <div class="theme-swatch-grid" id="themeSwatchGrid"><!-- populated by js/themes.js --></div>
      </div>

      <div class="field" id="pwaInstallField" style="display:none;">
        <label>Install App</label>
        <div class="note">Install StudyStudio to your device for offline access and a home-screen icon — no app store needed.</div>
        <div class="modal-actions" style="justify-content:flex-start; margin-top:8px;">
          <button class="btn btn-ghost" type="button" id="pwaInstallBtn">📲 Install StudyStudio</button>
        </div>
      </div>

      <div class="field">
        <label>Your Data</label>
        <div class="note" id="backupNote">Currently stored: — card(s), — tutor conversation(s).</div>

        <!-- Storage usage readout: rough estimate against a conservative
             5MB baseline (actual browser quotas vary, usually 5-10MB).
             Populated by refreshStorageUsageNote() in settings.js. -->
        <div class="storage-usage-block">
          <div class="storage-usage-bar-track">
            <div class="storage-usage-bar-fill" id="storageUsageBarFill" style="width:0%;"></div>
          </div>
          <div class="note" id="storageUsageNote" style="margin-top:4px;">Calculating storage usage…</div>
        </div>

        <div class="modal-actions" style="justify-content:flex-start; margin-top:8px;">
          <button class="btn btn-ghost" type="button" id="backupExportBtn">⬇ Export backup</button>
          <button class="btn btn-ghost" type="button" id="backupImportBtn">⬆ Import backup</button>
          <input type="file" id="backupImportInput" accept="application/json" style="display:none;">
        </div>
        <div class="note" id="backupImportStatus" style="margin-top:6px;"></div>
      </div>

      <div class="modal-actions">
        <button class="btn btn-ghost" id="settingsCancelBtn">Cancel</button>
        <button class="btn btn-primary" id="settingsSaveBtn">Save</button>
      </div>
    </div>
  </div>

  <!-- ====================================================================
       Scripts — classic (non-module) scripts sharing one global scope,
       same as the original single-file app. Order matters: each file
       depends on globals defined by the ones before it.
         1. config.js    — localStorage keys & shared constants
         2. api.js       — AI provider calls, quota, grading cache
         3. utils.js     — escapeHtml, markdown formatter, error-retry UI
         4. themes.js    — theme switching + swatch picker
         1. config.js    — localStorage keys & shared constants
         2. pwa.js         — service worker registration + install prompt
         3. api.js           — AI provider calls, quota, grading cache
         4. utils.js           — escapeHtml, markdown formatter, error-retry UI, undo toasts, storage-quota guard
         5. themes.js             — theme switching + swatch picker
         6. srs.js                  — spaced-repetition scheduler (SM-2)
         7. scores.js                 — quiz/exam score history log + trend UI
         8. export.js                    — deck export to Anki/CSV
         9. deck.js                         — flashcard deck, study/quiz/exam engines
        10. socratic.js                        — main Socratic tutor chat
        11. maker.js                              — mock quiz & exam maker
        12. side-tutor.js                            — in-quiz "ask the tutor" drawer
        13. gwa.js                                      — GWA calculator
        14. planner.js                                     — task/schedule planner
        15. watch.js                                          — Watch & Note (YouTube + timestamped notes/whiteboard + video tutor chat)
        16. dashboard.js                                         — landing-screen Due Today widget + stats strip (due cards, planner, GWA, notes)
        17. settings.js                                             — settings modal + data backup
        18. main.js                                                    — nav/view switching + app init (LAST)
  ==================================================================== -->
  <script src="js/config.js"></script>
  <script src="js/pwa.js"></script>
  <script src="js/api.js"></script>
  <script src="js/utils.js"></script>
  <script src="js/themes.js"></script>
  <script src="js/srs.js"></script>
  <script src="js/scores.js"></script>
  <script src="js/export.js"></script>
  <script src="js/deck.js"></script>
  <script src="js/socratic.js"></script>
  <script src="js/maker.js"></script>
  <script src="js/side-tutor.js"></script>
  <script src="js/gwa.js"></script>
  <script src="js/planner.js"></script>
  <script src="js/notes.js"></script>
  <script src="js/pomodoro.js"></script>
  <script src="js/watch.js"></script>
  <script src="js/dashboard.js"></script>
  <script src="js/settings.js"></script>
  <script src="js/main.js"></script>
</body>

</html>
