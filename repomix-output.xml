    /* ---------- OVERLAYS & MODALS ---------- */
    .overlay {
      position: fixed;
      inset: 0;
      background: var(--modal-backdrop, rgba(10, 12, 16, 0.6));
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 70;
      padding: 20px;
    }

    .overlay.open {
      display: flex;
    }

    .modal {
      background: var(--bg-alt);
      border: 1px solid var(--border);
      border-radius: 12px;
      width: 100%;
      max-width: 480px;
      padding: 26px;
      /* Cap height to the viewport (minus the .overlay's own padding)
         and let the modal itself scroll. Without this, a modal taller
         than the viewport (e.g. Settings with provider fields, theme
         swatches, and the backup section all visible at once) has no
         way to scroll — its bottom content, including the Save/Cancel
         buttons, ends up rendered below the fold with no scrollbar to
         reach it. Previously this fix only existed inside the
         <=640px media query; every other screen size was affected. */
      max-height: calc(100vh - 40px);
      max-height: calc(100svh - 40px);
      overflow-y: auto;
    }

    .modal h3 {
      font-size: 19px;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .modal .sub {
      color: var(--ink-soft);
      font-size: 13px;
      margin-bottom: 18px;
    }

    .field {
      margin-bottom: 14px;
    }

    .field label {
      display: block;
      font-size: 12.5px;
      color: var(--ink-soft);
      margin-bottom: 6px;
    }

    /* Form Fields and Custom Select Design */
