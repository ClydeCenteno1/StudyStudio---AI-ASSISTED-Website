      transition: opacity 0.15s ease, background 0.15s ease;
    }

    #tutorChatList {
      margin-top: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 320px;
      overflow-y: auto;
    }

    /* Tutor Sidebar Items */
    .tutor-chat-item {
      display: flex;
      justify-content: space-between;
