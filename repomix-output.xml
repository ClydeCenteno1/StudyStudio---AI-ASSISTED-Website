      background: rgba(193, 89, 75, 0.12);
    }
    .due-overdue .planner-card-due-badge .badge-month,
    .due-overdue .planner-card-due-badge .badge-day {
      color: var(--danger);
    }

    .due-today .planner-card-due-badge,
    .due-soon .planner-card-due-badge {
      border-color: var(--accent);
      background: rgba(216, 164, 56, 0.1);
    }
    .due-today .planner-card-due-badge .badge-month,
    .due-today .planner-card-due-badge .badge-day,
    .due-soon .planner-card-due-badge .badge-month,
    .due-soon .planner-card-due-badge .badge-day {
      color: var(--accent);
    }

    .planner-card-due-text {
      display: flex;
      flex-direction: column;
      gap: 1px;
    }

    .planner-card-due-relative {
      font-size: 10.5px;
      font-weight: 500;
      color: var(--ink-soft);
      opacity: 0.85;
    }

    .due-overdue .planner-card-due-relative { color: var(--danger); opacity: 1; }
    .due-today .planner-card-due-relative,
    .due-soon .planner-card-due-relative { color: var(--accent); opacity: 1; }

    .due-overdue .planner-card-due {
      color: var(--danger);
    }

    .due-today .planner-card-due,
    .due-soon .planner-card-due {
      color: var(--accent);
    }

    .planner-card-move {
      margin-top: 4px;
    }

    .planner-status-select {
      width: 100%;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--ink);
      font-size: 12.5px;
      padding: 6px 8px;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
    }

    .maker-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .file-drop-zone {
      border: 1.5px dashed var(--border);
      border-radius: 10px;
      padding: 20px;
      text-align: center;
      cursor: pointer;
      transition: border-color 0.15s ease, background 0.15s ease;
    }

    .file-drop-zone:hover,
    .file-drop-zone.drag-over {
      border-color: var(--accent);
      background: rgba(216, 164, 56, 0.05);
    }

    .file-drop-zone .dz-icon {
      font-size: 22px;
      margin-bottom: 6px;
    }

    .file-drop-zone .dz-text {
      font-size: 13px;
      color: var(--ink-soft);
    }

    .attached-files-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-top: 10px;
    }

    .attached-file-chip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 8px 12px;
      font-size: 12.5px;
      color: var(--ink);
    }

    .attached-file-chip .remove-file-btn {
      background: transparent;
      color: var(--danger);
      padding: 2px 6px;
      font-size: 13px;
    }

    /* ---------- QUIZ/EXAM Q-TYPE + HINT + SIDE TUTOR ---------- */
    .qtype-tag {
      display: inline-block;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.06em;
      color: var(--accent);
      border: 1px solid var(--border);
      border-radius: 100px;
      padding: 2px 9px;
      margin-bottom: 8px;
    }

    .hint-row {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      margin: 4px 0 2px;
    }

    .hint-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--accent);
      font-size: 12.5px;
      font-weight: 500;
      padding: 7px 13px;
      border-radius: 100px;
    }

    .hint-btn:hover {
      border-color: var(--accent);
    }

    .hint-btn:disabled {
      opacity: 0.5;
      cursor: default;
    }

    .hint-box {
      display: none;
      background: rgba(216, 164, 56, 0.08);
      border: 1px solid rgba(216, 164, 56, 0.35);
      border-radius: 8px;
      padding: 10px 13px;
      font-size: 13px;
      color: var(--ink);
      margin: 6px 0;
      line-height: 1.5;
    }

    .hint-box.shown {
      display: block;
    }

    .ask-tutor-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--teal);
      font-size: 12.5px;
      font-weight: 500;
      padding: 7px 13px;
      border-radius: 100px;
    }

    .ask-tutor-btn:hover {
      border-color: var(--teal);
    }

    /* Side tutor drawer, usable from inside quiz/exam overlays */
    .side-tutor-drawer {
      position: fixed;
      top: 0;
      right: -420px;
      width: 400px;
      max-width: 92vw;
      height: 100%;
      background: var(--bg-alt);
      border-left: 1px solid var(--border);
      z-index: 90;
      display: flex;
      flex-direction: column;
      transition: right 0.22s ease;
      box-shadow: -8px 0 24px rgba(0, 0, 0, 0.3);
    }

    .side-tutor-drawer.open {
      right: 0;
    }

    .side-tutor-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 18px;
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }

    .side-tutor-header h4 {
      font-size: 14.5px;
      font-weight: 600;
    }

    .side-tutor-chat {
      flex: 1;
      overflow-y: auto;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .side-tutor-composer {
      border-top: 1px solid var(--border);
      padding: 12px 14px;
      flex-shrink: 0;
      display: flex;
      gap: 8px;
    }

    .side-tutor-composer textarea {
      flex: 1;
      resize: none;
      height: 40px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 7px;
      color: var(--ink);
      padding: 9px 11px;
      font-size: 13px;
      font-family: 'Inter', sans-serif;
      outline: none;
    }

    .float-tutor-fab {
      position: fixed;
      bottom: 26px;
      right: 26px;
      z-index: 60;
      background: var(--teal);
      color: #0e1712;
      border-radius: 100px;
      padding: 12px 18px;
      font-size: 13px;
      font-weight: 600;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
      display: none;
      align-items: center;
      gap: 8px;
    }

    .float-tutor-fab.visible {
      display: flex;
    }

    .maker-loading {
      display: none;
      align-items: center;
      gap: 10px;
      color: var(--ink-soft);
      font-size: 13px;
      margin-top: 14px;
    }

    .maker-loading.active {
      display: flex;
    }

    .spinner {
      width: 15px;
      height: 15px;
      border-radius: 50%;
      border: 2px solid var(--border);
      border-top-color: var(--accent);
      animation: spin 0.7s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* =========================================================
       RESPONSIVE OVERHAUL
       ========================================================= */

    /* Mobile viewport height fix: 100vh is unreliable on phones
       because browser chrome (address bar) resizes it. Use the
       small-viewport unit with a fallback. */
    html, body {
      height: 100vh;
      height: 100svh;
    }

    /* Sidebar drawer toggle (mobile) — hidden by default via
       transform rather than display:none, so JS can open it. */
    .sidebar-drawer-toggle {
      display: none;
    }
    .sidebar-scrim {
      display: none;
    }

    @media (max-width: 640px) {
      .sidebar-drawer-toggle {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 20;
        background: var(--panel);
      }
    }

    @media (max-width: 900px) {
      .landing-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 980px) {
      .side-tutor-drawer {
        width: 360px;
      }
    }

    /* ---------- Tablet & below ---------- */
    @media (max-width: 860px) {
      .topbar {
        height: auto;
        min-height: 60px;
        padding: 10px 14px;
        flex-wrap: wrap;
        row-gap: 8px;
      }

      .brand-nav {
        gap: 12px;
        min-width: 0;
      }

      .brand-nav h1 {
        font-size: 17px;
      }

      .nav-tabs {
        order: 3;
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        justify-content: flex-start;
      }

      .nav-tabs::-webkit-scrollbar {
        display: none;
      }

      .nav-tab {
        white-space: nowrap;
        flex-shrink: 0;
        padding: 7px 12px;
      }

      .topbar-actions {
        gap: 6px;
      }

      #cardCountStamp {
        display: none;
      }

      .deck-container,
      .maker-container {
        padding: 20px 16px 60px;
      }

      .planner-board {
        grid-template-columns: 1fr;
      }

      .planner-add-form {
        flex-direction: column;
        align-items: stretch;
      }

      .planner-add-form .maker-field {
        min-width: 0;
      }

      .planner-add-form button {
        width: 100%;
      }

      .deck-toolbar {
        flex-wrap: wrap;
        gap: 10px;
      }

      .deck-toolbar-left {
        flex-wrap: wrap;
        row-gap: 6px;
      }

      .grid {
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 12px;
      }

      .card-flip {
        height: 150px;
      }

      .landing-inner h1 {
        font-size: 26px;
      }

      .side-tutor-drawer {
        width: 100%;
        max-width: 100vw;
        right: -100%;
      }

      .float-tutor-fab {
        bottom: 16px;
        right: 16px;
        padding: 10px 14px;
        font-size: 12.5px;
      }
    }

    /* ---------- Phones ---------- */
    @media (max-width: 640px) {
      .landing-grid {
        grid-template-columns: 1fr;
      }

      .landing-inner h1 {
        font-size: 22px;
      }

      .landing-inner .sub {
        font-size: 13.5px;
        margin-bottom: 24px;
      }

      .landing-card {
        padding: 20px 18px;
      }

      .maker-row {
        grid-template-columns: 1fr;
      }

      .srs-rate-btns {
        grid-template-columns: repeat(2, 1fr);
      }

      .due-banner {
        flex-direction: column;
        align-items: stretch;
        text-align: center;
      }

      .overlay {
        padding: 0;
        align-items: flex-end;
      }

      .overlay .modal,
      .overlay .study-container {
        max-width: 100%;
        width: 100%;
        border-radius: 14px 14px 0 0;
        max-height: 92svh;
        overflow-y: auto;
      }

      .study-header {
        flex-wrap: wrap;
        row-gap: 8px;
      }

      .study-card-wrapper {
        height: 220px;
      }

      .study-controls {
        flex-wrap: wrap;
      }

      .study-controls .btn {
        flex: 1;
        min-width: 120px;
      }

      /* Socratic tutor becomes a single column with a slide-out
         conversation drawer instead of vanishing entirely. */
      .socratic-main {
        position: relative;
      }

      .sidebar {
        display: flex;
        position: fixed;
        top: 0;
        left: -280px;
        width: 260px;
        height: 100%;
        background: var(--bg-alt);
        z-index: 95;
        box-shadow: 8px 0 24px rgba(0, 0, 0, 0.35);
        transition: left 0.2s ease;
        border-right: 1px solid var(--border);
      }

      .sidebar.open {
        left: 0;
      }

      .sidebar-scrim {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(10, 12, 16, 0.55);
        z-index: 94;
      }

      .sidebar-scrim.open {
        display: block;
      }

      .sidebar-drawer-toggle {
        display: flex;
      }

      .chat-scroll {
        padding-top: 56px;
      }

      .msg-row {
        max-width: 100%;
      }

      .quick-actions {
        max-width: 100%;
        overflow-x: auto;
        flex-wrap: nowrap;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 4px;
      }

      .quick-btn {
        flex-shrink: 0;
      }

      .composer {
        padding: 10px 12px 14px;
      }

      .composer-inner {
        max-width: 100%;
      }

      .exam-q-block input,
      .maker-field input,
      .maker-field textarea,
      .maker-field select {
        font-size: 16px;
        /* 16px prevents iOS Safari from auto-zooming on focus */
      }

      .side-tutor-composer {
        padding-bottom: max(12px, env(safe-area-inset-bottom));
      }

      .modal-actions {
        flex-wrap: wrap;
      }

      .modal-actions .btn {
        flex: 1;
      }
    }

    @media (max-width: 420px) {
      .brand-nav h1 {
        display: none;
      }

      .nav-tab {
        font-size: 12px;
        padding: 6px 9px;
      }

      .quiz-option-btn {
        padding: 11px 13px;
        font-size: 13.5px;
      }

      .exam-score-banner {
        font-size: 24px;
        padding: 14px 0;
      }

      .quiz-question-box .body {
        font-size: 14px;
      }
    }

    /* ==================== NOTES ==================== */

    .notes-main {
      flex: 1;
      display: flex;
      min-height: 0;
      height: 100%;
      overflow: hidden;
    }

    .notes-sidebar {
      gap: 10px;
    }

    .note-list-item {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 12px;
      margin-bottom: 8px;
      cursor: pointer;
      transition: border-color 0.15s ease;
    }

    .note-list-item:hover {
      border-color: var(--ink-soft);
    }

    .note-list-item.active {
      border-color: var(--accent);
    }

    .note-list-item-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }

    .note-list-item-title {
      font-size: 13.5px;
      font-weight: 500;
      color: var(--ink);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .note-list-item-del {
      width: 22px;
      height: 22px;
      font-size: 12px;
      flex-shrink: 0;
      opacity: 0.6;
    }

    .note-list-item-del:hover {
      opacity: 1;
    }

    .note-list-item-preview {
      font-size: 12px;
      color: var(--ink-soft);
      margin-top: 4px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .note-list-item-date {
      font-size: 10.5px;
      color: var(--ink-soft);
      opacity: 0.7;
      margin-top: 6px;
    }

    .notes-editor-col {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 0;
      height: 100%;
      position: relative;
    }

    .note-editor-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 18px 20px;
      gap: 14px;
    }

    .note-editor-toolbar {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }

    .note-title-input {
      flex: 1;
      min-width: 0;
      background: transparent;
      border: none;
      border-bottom: 1px solid var(--border);
      font-family: 'Fraunces', serif;
      font-size: 19px;
      font-weight: 600;
      color: var(--ink);
      padding: 6px 2px;
    }

    .note-title-input:focus {
      outline: none;
      border-bottom-color: var(--accent);
    }

    .note-saved-stamp {
      font-size: 10.5px;
      color: var(--ink-soft);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .note-editor-panes {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      min-height: 0;
    }

    .note-body-input {
      resize: none;
      height: 100%;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 13.5px;
      line-height: 1.65;
      padding: 16px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      color: var(--ink);
    }

    .note-body-input:focus {
      outline: none;
      border-color: var(--accent);
    }

    .note-preview-pane {
      height: 100%;
      overflow-y: auto;
      padding: 16px 18px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      font-size: 14px;
      line-height: 1.65;
      color: var(--ink);
    }

    .note-preview-placeholder {
      color: var(--ink-soft);
      font-size: 13px;
      font-style: italic;
    }

    @media (max-width: 860px) {
      .note-editor-panes {
        grid-template-columns: 1fr;
        grid-template-rows: 1fr 1fr;
      }
    }

    @media (max-width: 640px) {
      .note-editor-toolbar {
        flex-wrap: wrap;
      }
      .note-title-input {
        order: -1;
        width: 100%;
        flex-basis: 100%;
      }
      .note-editor-main {
        padding-top: 56px;
      }
    }

    /* ==================== POMODORO WIDGET ==================== */

    .pomodoro-widget {
      position: fixed;
      bottom: 20px;
      right: 20px;
      z-index: 80;
      font-family: 'Inter', sans-serif;
    }

    .pomodoro-pill {
      display: none;
      align-items: center;
      gap: 6px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 9px 16px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 13px;
      color: var(--ink);
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    }

    .pomodoro-widget.minimized .pomodoro-pill {
      display: flex;
    }

    .pomodoro-widget.minimized .pomodoro-card {
      display: none;
    }

    .pomodoro-card {
      width: 210px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px 16px 16px;
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.3);
    }

    .pomodoro-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .pomodoro-phase-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-soft);
    }

    .pomodoro-widget[data-phase="work"] .pomodoro-phase-label {
      color: var(--accent);
    }

    .pomodoro-widget[data-phase="shortBreak"] .pomodoro-phase-label,
    .pomodoro-widget[data-phase="longBreak"] .pomodoro-phase-label {
      color: var(--teal);
    }

    .pomodoro-card-top .icon-btn {
      width: 24px;
      height: 24px;
      font-size: 13px;
    }

    .pomodoro-ring {
      --pomodoro-pct: 0;
      width: 120px;
      height: 120px;
      margin: 4px auto 10px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: conic-gradient(var(--accent) calc(var(--pomodoro-pct) * 360deg), var(--bg-alt) 0deg);
      position: relative;
      transition: background 0.4s ease;
    }

    .pomodoro-ring::before {
      content: "";
      position: absolute;
      inset: 8px;
      border-radius: 50%;
      background: var(--panel);
    }

    .pomodoro-time {
      position: relative;
      font-size: 22px;
      color: var(--ink);
      z-index: 1;
    }

    .pomodoro-dots {
      display: flex;
      justify-content: center;
      gap: 6px;
      margin-bottom: 12px;
    }

    .pomodoro-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--bg-alt);
      border: 1px solid var(--border);
    }

    .pomodoro-dot.filled {
      background: var(--accent);
      border-color: var(--accent);
    }

    .pomodoro-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
    }

    .pomodoro-play-btn {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      padding: 0;
      font-size: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .pomodoro-controls .icon-btn {
      width: 32px;
      height: 32px;
      font-size: 14px;
    }

    .pomodoro-phase-banner {
      margin-top: 10px;
      font-size: 11.5px;
      color: var(--ink-soft);
      text-align: center;
      line-height: 1.4;
      opacity: 0;
      max-height: 0;
      overflow: hidden;
      transition: opacity 0.25s ease;
    }

    .pomodoro-phase-banner.show {
      opacity: 1;
      max-height: 40px;
    }

    @media (max-width: 640px) {
      .pomodoro-widget {
        bottom: 12px;
        right: 12px;
      }
      .pomodoro-card {
        width: 190px;
      }
    }

    /* ==================== PLANNER: CUSTOM DATE PICKER ==================== */

    .planner-date-trigger {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      background: var(--bg-alt);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 12px;
      font-size: 13.5px;
      color: var(--ink);
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: border-color 0.15s ease;
    }

    .planner-date-trigger:hover {
      border-color: var(--ink-soft);
    }

    .planner-date-trigger.has-date {
      color: var(--ink);
      border-color: var(--accent);
    }

    .planner-date-trigger-icon {
      font-size: 13px;
      opacity: 0.8;
    }

    .planner-cal-popover {
      display: none;
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      z-index: 60;
      width: 260px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      box-shadow: 0 10px 32px rgba(0, 0, 0, 0.3);
    }

    .planner-cal-popover.open {
      display: block;
    }

    .planner-cal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .planner-cal-header .icon-btn {
      width: 26px;
      height: 26px;
      font-size: 15px;
    }

    .planner-cal-month-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--ink);
      letter-spacing: 0.02em;
    }

    .planner-cal-weekdays {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      margin-bottom: 4px;
    }

    .planner-cal-weekdays span {
      text-align: center;
      font-size: 10px;
      font-weight: 600;
      color: var(--ink-soft);
      text-transform: uppercase;
    }

    .planner-cal-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 3px;
    }

    .planner-cal-day {
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      background: transparent;
      border-radius: 7px;
      font-size: 12.5px;
      color: var(--ink);
      cursor: pointer;
      font-family: 'IBM Plex Mono', monospace;
      transition: background 0.12s ease;
    }

    .planner-cal-day:hover:not(:disabled) {
      background: var(--bg-alt);
    }

    .planner-cal-day.other-month {
      color: var(--ink-soft);
      opacity: 0.4;
    }

    .planner-cal-day.is-today {
      border: 1px solid var(--accent);
    }

    .planner-cal-day.is-selected {
      background: var(--accent);
      color: var(--accent-ink);
      font-weight: 700;
    }

    .planner-cal-day.is-past {
      opacity: 0.35;
    }

    .planner-cal-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid var(--border);
    }

    .planner-cal-footer .link-danger {
      font-size: 12px;
    }

    .planner-cal-today-btn {
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 5px 12px;
      font-size: 12px;
      color: var(--ink);
      cursor: pointer;
      transition: border-color 0.15s ease;
    }

    .planner-cal-today-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    @media (max-width: 640px) {
      .planner-cal-popover {
        left: auto;
        right: 0;
        width: 240px;
      }
    }

    /* ---------- Planner ↔ Deck/Notes link picker ---------- */
    .planner-link-list {
      display: flex;
      flex-direction: column;
      gap: 4px;
      max-height: 220px;
      overflow-y: auto;
    }

    .planner-link-option {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      text-align: left;
      background: transparent;
      border: none;
      border-radius: 7px;
      padding: 8px 9px;
      font-size: 12.5px;
      color: var(--ink);
      cursor: pointer;
      transition: background 0.12s ease;
    }

    .planner-link-option:hover {
      background: var(--bg-alt);
    }

    .planner-link-option span:last-child {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .planner-card-link-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      align-self: flex-start;
      background: var(--bg-alt);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 4px 10px;
      font-size: 11.5px;
      color: var(--ink);
      cursor: pointer;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      transition: border-color 0.15s ease, color 0.15s ease;
    }

    .planner-card-link-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    /* ==================== Watch & Note ==================== */

    .watch-editor-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 18px 20px;
      gap: 14px;
    }

    .watch-editor-panes {
      flex: 1;
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 16px;
      min-height: 0;
    }

    .watch-video-pane {
      height: 100%;
      min-height: 0;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .watch-video-placeholder {
      text-align: center;
      color: var(--ink-soft);
      padding: 20px;
    }

    .watch-video-placeholder .dz-icon {
      font-size: 30px;
      margin-bottom: 8px;
      opacity: 0.7;
    }

    #watchPlayerMount {
      width: 100%;
      height: 100%;
    }

    #watchPlayerMount iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }

    .watch-side-pane {
      height: 100%;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    /* ---------- Notes mode ---------- */
    .watch-notes-mode {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
      gap: 10px;
    }

    .watch-notes-composer {
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 10px;
    }

    .watch-notes-composer textarea {
      resize: none;
      min-height: 54px;
      font-size: 13px;
      line-height: 1.5;
      background: transparent;
      border: none;
      color: var(--ink);
      padding: 2px;
    }

    .watch-notes-composer textarea:focus {
      outline: none;
    }

    .watch-notes-composer .btn {
      align-self: flex-end;
    }

    .watch-notes-list {
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .watch-note-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 9px 11px;
    }

    .watch-note-timestamp {
      flex-shrink: 0;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11.5px;
      font-weight: 600;
      color: var(--accent);
      background: var(--bg-alt);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 2px 7px;
      cursor: pointer;
      white-space: nowrap;
    }

    .watch-note-timestamp:hover {
      border-color: var(--accent);
    }

    .watch-note-text {
      flex: 1;
      font-size: 13px;
      line-height: 1.5;
      color: var(--ink);
      white-space: pre-wrap;
      word-break: break-word;
    }

    .watch-note-del {
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      font-size: 11px;
      opacity: 0.5;
    }

    .watch-note-del:hover {
      opacity: 1;
    }

    /* ---------- Whiteboard mode ---------- */
    .watch-whiteboard-mode {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
      gap: 8px;
    }

    .watch-wb-toolbar {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 8px 10px;
    }

    .watch-wb-colors {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .watch-wb-color {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      border: 2px solid var(--border);
      cursor: pointer;
      padding: 0;
    }

    .watch-wb-color.active {
      border-color: var(--ink);
      transform: scale(1.15);
    }

    #watchWhiteboardCanvas {
      flex: 1;
      min-height: 0;
      width: 100%;
      background: #fdfdfb;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      cursor: crosshair;
      touch-action: none;
    }

    @media (max-width: 860px) {
      .watch-editor-panes {
        grid-template-columns: 1fr;
        grid-template-rows: 240px 1fr;
      }
    }

    /* ==================== Storage Usage Readout (Settings) ==================== */

    .storage-usage-block {
      margin-top: 10px;
    }

    .storage-usage-bar-track {
      width: 100%;
      height: 8px;
      border-radius: 100px;
      background: var(--border);
      overflow: hidden;
    }

    .storage-usage-bar-fill {
      height: 100%;
      border-radius: 100px;
      background: var(--accent);
      transition: width 0.25s ease, background 0.25s ease;
    }

    .storage-usage-bar-fill.warn {
      background: var(--danger);
    }

    /* ==================== Storage Full Banner ==================== */

    .storage-full-banner {
      position: sticky;
      top: 0;
      z-index: 9998;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      background: var(--danger);
      color: #fff;
      font-size: 13px;
      font-weight: 500;
      padding: 10px 20px;
      text-align: center;
    }

    .storage-full-dismiss {
      flex-shrink: 0;
      background: none;
      border: none;
      color: #fff;
      opacity: 0.85;
      cursor: pointer;
      font-size: 14px;
      padding: 2px 6px;
    }

    .storage-full-dismiss:hover {
      opacity: 1;
    }

    @media (max-width: 640px) {
      .storage-full-banner {
        flex-direction: column;
        gap: 6px;
        padding: 10px 14px;
      }
    }

    /* ==================== Undo Toast ==================== */

    .undo-toast-container {
      position: fixed;
      left: 50%;
      bottom: 24px;
      transform: translateX(-50%);
      z-index: 9999;
      display: flex;
      flex-direction: column-reverse;
      gap: 8px;
      pointer-events: none;
    }

    .undo-toast {
      pointer-events: auto;
      display: flex;
      align-items: center;
      gap: 14px;
      background: var(--ink);
      color: var(--bg);
      border-radius: 10px;
      padding: 12px 16px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.25);
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.18s ease, transform 0.18s ease;
      max-width: 90vw;
    }

    .undo-toast.show {
      opacity: 1;
      transform: translateY(0);
    }

    .undo-toast-msg {
      font-size: 13.5px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .undo-toast-btn {
      flex-shrink: 0;
      background: none;
      border: none;
      color: var(--accent);
      font-weight: 700;
      font-size: 13.5px;
      cursor: pointer;
      padding: 2px 4px;
    }

    .undo-toast-btn:hover {
      text-decoration: underline;
    }

    @media (max-width: 640px) {
      .undo-toast {
        max-width: calc(100vw - 32px);
      }
      .undo-toast-msg {
        white-space: normal;
      }
    }

    /* ==================== Due Today Widget (landing screen) ==================== */

    .due-today-widget {
      max-width: 900px;
      margin: 0 auto 18px;
      background: var(--panel);
      border: 1px solid var(--accent);
      border-radius: var(--radius);
      padding: 16px 20px;
    }

    .due-today-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .due-today-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 15px;
      font-weight: 600;
      color: var(--ink);
    }

    .due-today-icon {
      font-size: 18px;
      line-height: 1;
    }

    .due-today-decks {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-top: 12px;
    }

    .due-today-deck-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 8px 12px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 10px;
    }

    .due-today-deck-name {
      font-size: 13.5px;
      color: var(--ink);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .due-today-deck-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .due-today-deck-count {
      font-size: 12.5px;
      color: var(--ink-soft);
      white-space: nowrap;
    }

    .btn-sm {
      padding: 6px 12px;
      font-size: 12.5px;
    }

    @media (max-width: 640px) {
      .due-today-header {
        flex-direction: column;
        align-items: stretch;
      }
      .due-today-header .btn {
        width: 100%;
      }
    }

    /* ==================== Dashboard Strip (landing screen) ==================== */

    .dashboard-strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 10px;
      max-width: 900px;
      margin: 0 auto 28px;
    }

    .dash-stat {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px 16px;
      text-align: left;
      cursor: pointer;
      transition: border-color 0.15s ease, transform 0.12s ease;
    }

    .dash-stat:hover {
      border-color: var(--accent);
      transform: translateY(-1px);
    }

    .dash-stat-value {
      font-family: 'Fraunces', serif;
      font-size: 24px;
      font-weight: 600;
      color: var(--ink);
      line-height: 1.1;
    }

    .dash-stat-value.warn {
      color: var(--danger);
    }

    .dash-stat-label {
      font-size: 11.5px;
      color: var(--ink-soft);
      margin-top: 4px;
    }

    @media (max-width: 640px) {
      .dashboard-strip {
        grid-template-columns: repeat(2, 1fr);
      }
    }
