      font-size: 15px;
      margin-bottom: 28px;
    }

    textarea {
      width: 100%;
      min-height: 160px;
      resize: vertical;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      color: var(--ink);
      font-family: 'Inter', sans-serif;
      font-size: 14.5px;
      line-height: 1.55;
      padding: 16px;
      outline: none;
    }

    textarea:focus {
      border-color: var(--accent);
    }

    textarea::placeholder {
      color: var(--ink-soft);
    }

    .deck-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 22px;
    }

    .deck-toolbar-left {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--ink-soft);
      font-size: 13.5px;
    }

    .link-danger {
      background: none;
      color: var(--ink-soft);
      font-size: 13px;
      border: none;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .link-danger:hover {
      color: var(--danger);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: 18px;
    }

    .card-flip {
      perspective: 1200px;
      height: 180px;
      position: relative;
    }

    .card-del {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--overlay-backdrop);
      color: var(--ink);
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 5;
      opacity: 0;
      transition: opacity 0.15s ease, background 0.15s ease;
    }

    .card-flip:hover .card-del {
      opacity: 1;
    }

    .card-del:hover {
      background: var(--danger);
    }

    .card-inner {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.5s cubic-bezier(0.4, 0.2, 0.2, 1);
      cursor: pointer;
    }

    .card-flip.flipped .card-inner {
      transform: rotateY(180deg);
    }

    .card-face {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
      background: var(--card);
      color: #24211c;
      border-radius: 6px;
      padding: 20px 18px 16px;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28);
      display: flex;
      flex-direction: column;
    }

    .card-face::before {
      content: "";
      position: absolute;
      top: 34px;
      left: 0;
      right: 0;
      height: 1px;
      background: var(--card-line);
      opacity: 0.35;
    }

    .card-face .tag {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.08em;
      color: #8a7f68;
      margin-bottom: 14px;
    }

    .card-face .body {
      font-size: 14.5px;
      line-height: 1.45;
      overflow-y: auto;
      flex: 1;
    }

    .card-back {
      transform: rotateY(180deg);
      background: #ece5d4;
    }

    /* ---------- STUDY MODE STYLES ---------- */
    .study-container {
      background: var(--bg-alt);
      border: 1px solid var(--border);
      border-radius: 12px;
      width: 100%;
      max-width: 640px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
      /* Same off-screen-content bug as .modal: a long exam question
         list (or the results view with per-question feedback) can
         exceed the viewport with nothing to scroll it otherwise. */
      max-height: calc(100vh - 40px);
      max-height: calc(100svh - 40px);
      overflow-y: auto;
    }

    .study-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      row-gap: 8px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 14px;
    }

    #studyDeckTitle,
    #quizDeckTitle,
    #examDeckTitle {
      font-size: 14px;
      color: var(--accent);
      font-weight: 500;
      /* Long deck titles used to push the score/due/progress stamps and
         the close button off to the side with nothing to stop them —
         truncate with an ellipsis instead, and let the header wrap
         (flex-wrap above) as a fallback if it still doesn't fit. */
      flex: 1 1 160px;
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* The stamps (score/due/progress) and close button sit alongside the
       title in the same flex row — keep them at their natural size no
       matter how much the title above wants to shrink or wrap. */
    .study-header > .stamp,
    .study-header > .icon-btn {
      flex-shrink: 0;
    }

    .study-card-wrapper {
      height: 280px;
      width: 100%;
    }

    .study-card-flip {
      height: 100% !important;
    }

    .study-controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }

    .btn-study-action {
      background: var(--accent);
      color: var(--accent-ink);
      font-size: 12.5px;
      padding: 5px 10px;
      border-radius: 6px;
      font-weight: 600;
      transition: background 0.15s ease;
    }

    .btn-study-action:hover {
      background: #e5b04f;
    }

    .study-answer-row {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .study-answer-row input {
      flex: 1;
      min-width: 0;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--ink);
      font-family: 'Inter', sans-serif;
      font-size: 14.5px;
      padding: 11px 14px;
      outline: none;
    }

    .study-answer-row input:focus {
      border-color: var(--accent);
    }

    .study-verdict {
      font-size: 13.5px;
      line-height: 1.5;
      min-height: 1.4em;
      padding: 0 2px;
    }

    .study-verdict.pending {
      color: var(--ink-soft);
    }

    .study-verdict.right {
      color: var(--teal);
    }

    .study-verdict.wrong {
      color: var(--danger);
    }

    /* ---------- SRS SELF-RATING ROW ---------- */
    .srs-rate-row {
      flex-direction: column;
      gap: 8px;
      align-items: stretch;
      animation: srsRateIn 0.15s ease;
    }

    @keyframes srsRateIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .srs-rate-label {
      font-size: 12px;
      color: var(--ink-soft);
      text-align: center;
    }

    .srs-rate-btns {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }

    .srs-rate-btn {
      padding: 10px 8px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      border: 1px solid var(--border);
      color: var(--ink);
      background: var(--panel);
      transition: transform 0.12s ease, filter 0.15s ease;
    }

    .srs-rate-btn:hover {
      filter: brightness(1.1);
      transform: translateY(-1px);
    }

    .srs-rate-btn.srs-again { border-color: var(--danger); color: var(--danger); }
    .srs-rate-btn.srs-hard  { border-color: var(--accent); color: var(--accent); }
    .srs-rate-btn.srs-good  { border-color: var(--teal);   color: var(--teal); }
    .srs-rate-btn.srs-easy  { background: var(--teal); border-color: var(--teal); color: #0e1712; }

    /* ---------- MODE SELECTOR ---------- */
    .mode-choice-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 6px;
    }

    .mode-choice-btn {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 14px 16px;
      text-align: left;
      transition: border-color 0.15s ease, transform 0.12s ease;
    }

    .mode-choice-btn:hover {
      border-color: var(--accent);
      transform: translateY(-1px);
    }

    .mode-choice-title {
      font-size: 14.5px;
      font-weight: 600;
      color: var(--ink);
    }

    .mode-choice-desc {
      font-size: 12.5px;
      color: var(--ink-soft);
      line-height: 1.4;
    }

    /* ---------- QUIZ MODE ---------- */
    .quiz-question-box {
      background: var(--card);
      color: #24211c;
      border-radius: 8px;
      padding: 20px 18px;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
    }

    .quiz-question-box .tag {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.08em;
      color: #8a7f68;
      margin-bottom: 10px;
      display: block;
    }

    .quiz-question-box .body {
      font-size: 15px;
      line-height: 1.5;
    }

    .quiz-options {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .quiz-option-btn {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 13px 16px;
