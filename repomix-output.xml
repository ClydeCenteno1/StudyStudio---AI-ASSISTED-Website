    }

    .folder-rename-btn,
    .folder-delete-btn,
    .folder-history-btn,
    .folder-export-btn {
      width: 30px;
      height: 30px;
      border: none;
      background: transparent;
      color: var(--ink-soft);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all .15s ease;
      opacity: 0;
      font-size: 13px;
    }

    .folder-card:hover .folder-rename-btn,
    .folder-card:hover .folder-delete-btn,
    .folder-card:hover .folder-history-btn,
    .folder-card:hover .folder-export-btn {
      opacity: 1;
    }

    .folder-history-btn:hover,
    .folder-export-btn:hover {
      color: var(--ink);
      background: var(--bg-alt);
    }

    /* ---------- Score trend strip (deck folder card) ---------- */
    .score-trend-strip {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 2px 0;
    }

    .score-sparkline {
      display: block;
      flex-shrink: 0;
    }

    .score-trend-badge {
      font-size: 11px;
      font-weight: 500;
      padding: 3px 7px;
      border-radius: 20px;
      background: var(--bg-alt);
