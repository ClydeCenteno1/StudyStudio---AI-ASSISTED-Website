<file path="index.html">
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StudyStudio — Learning Suite</title>

  <!--
    Sets the saved theme (or "dark" default) on <html> BEFORE the
    stylesheets below paint, so there's no flash-of-default-theme on
    load. Kept intentionally tiny and dependency-free — the full
    theme system (palettes, swatch picker) lives in css/themes.css
    and js/themes.js, loaded later like everything else.
  -->
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('deckflip_theme');
        var valid = ['dark', 'light', 'pink', 'red', 'forest', 'ocean'];
        document.documentElement.setAttribute('data-theme', valid.indexOf(saved) !== -1 ? saved : 'dark');
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">

  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>

  <!-- PWA: installable app shell + offline support (see js/pwa.js and sw.js) -->
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#14181f">
  <link rel="icon" href="icons/icon-192.png">
  <link rel="apple-touch-icon" href="icons/icon-192.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="StudyStudio">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet">

  <!-- Base layout/component styles (uses CSS variables for all color) -->
  <link rel="stylesheet" href="css/style.css">
  <!-- Theme palettes (Dark/Light/Pink/Red/Forest/Ocean) + swatch picker UI.
       Loaded after style.css so its [data-theme] overrides win. -->
  <link rel="stylesheet" href="css/themes.css">
</head>

<body>

  <!-- LANDING / SELECTION SCREEN -->
  <div id="landingScreen">
    <div class="landing-inner">
      <h1>StudyStudio</h1>
      <div class="sub">What do you want to do today?</div>

      <!-- First-run hint: shown only when no AI provider key is set yet
           and the user hasn't dismissed it. See main.js initOnboardingHint(). -->
      <div id="onboardingHint" class="onboarding-hint" style="display:none;">
        <span>👋 New here? The Flashcard, Maker, and Socratic Tutor features need a free AI API key to work.</span>
        <div class="onboarding-hint-actions">
          <button type="button" class="btn btn-primary" id="onboardingSetupBtn">Set up now</button>
          <button type="button" class="icon-btn" id="onboardingDismissBtn" title="Dismiss">✕</button>
        </div>
      </div>

      <!-- Due Today widget: standalone per-deck SRS breakdown with a
           one-click "Review now" per deck plus a "Review all" action.
           Populated by js/dashboard.js. Hidden entirely when nothing
           is due. Sits above the stats strip since reviewing is the
           single most actionable thing a returning student can do. -->
      <div class="due-today-widget" id="dueTodayWidget" style="display:none;">
        <div class="due-today-header">
          <div class="due-today-title">
            <span class="due-today-icon">📚</span>
            <span id="dueTodayHeadline">Cards due today</span>
          </div>
          <button type="button" class="btn btn-primary btn-sm" id="dueTodayReviewAllBtn">▶ Review all</button>
        </div>
        <div class="due-today-decks" id="dueTodayDecks"></div>
      </div>

      <!-- Dashboard strip: quick glance at what's due/pending across
           features, computed from existing storage (no new data model).
           Populated by js/dashboard.js. Hidden entirely if there's
           nothing to show yet (brand-new install). -->
      <div class="dashboard-strip" id="dashboardStrip" style="display:none;"></div>

      <div class="landing-grid">
        <button class="landing-card" id="landingNotesBtn">
          <div class="icon">🗒️</div>
          <h3>Notes</h3>
          <p>Write notes with live Markdown & LaTeX preview, then turn any note straight into a flashcard deck in one click.</p>
          <div class="go">OPEN →</div>
        </button>
        <button class="landing-card" id="landingFlashcardBtn">
          <div class="icon">⚡</div>
          <h3>Flashcards</h3>
          <p>Paste your notes and get a full deck of flashcards. Study, flip, and self-check with AI grading.</p>
          <div class="go">OPEN →</div>
        </button>
        <button class="landing-card" id="landingMakerBtn">
          <div class="icon">📝</div>
          <h3>Mock Quiz & Exam Maker</h3>
          <p>Give a topic, upload notes/photos/PDFs, and choose your question types. Get a custom quiz or timed exam, complete with hints.</p>
          <div class="go">OPEN →</div>
        </button>
        <button class="landing-card" id="landingSocraticBtn">
          <div class="icon">🏛️</div>
          <h3>Socratic Tutor</h3>
          <p>Stuck on a problem? Talk it through step-by-step with a tutor that asks guiding questions instead of just giving answers.</p>
          <div class="go">OPEN →</div>
        </button>
        <button class="landing-card" id="landingGwaBtn">
          <div class="icon">🎓</div>
          <h3>GWA Calculator</h3>
          <p>Compute your Philippine General Weighted Average — add each subject's grade and units, and get your GWA instantly.</p>
          <div class="go">OPEN →</div>
        </button>
        <button class="landing-card" id="landingPlannerBtn">
          <div class="icon">🗓️</div>
          <h3>Schedule Planner</h3>
          <p>Track exams, deadlines, and to-dos on a simple board. See what's due soon at a glance, right alongside your decks.</p>
          <div class="go">OPEN →</div>
        </button>
        <button class="landing-card" id="landingWatchBtn">
          <div class="icon">▶️</div>
          <h3>Watch & Note</h3>
          <p>Paste a YouTube link and take timestamped notes or sketch on a whiteboard right beside the video, without switching tabs.</p>
          <div class="go">OPEN →</div>
        </button>
      </div>
    </div>
  </div>

  <!-- Universal Topbar -->
  <div class="topbar">
    <div class="brand-nav">
      <button class="icon-btn back-to-menu-btn" id="backToMenuBtn" title="Back to menu">☰</button>
      <h1>StudyStudio</h1>
      <div class="nav-tabs">
        <button class="nav-tab" id="tabNotesBtn">🗒️ Notes</button>
        <button class="nav-tab active" id="tabDeckBtn">⚡ Flashcard Deck</button>
        <button class="nav-tab" id="tabMakerBtn">📝 Mock Quiz & Exam</button>
        <button class="nav-tab" id="tabSocraticBtn">🏛️ Socratic Tutor</button>
        <button class="nav-tab" id="tabGwaBtn">🎓 GWA Calculator</button>
        <button class="nav-tab" id="tabPlannerBtn">🗓️ Planner</button>
        <button class="nav-tab" id="tabWatchBtn">▶️ Watch</button>
      </div>
    </div>
    <div class="topbar-actions">
      <span class="stamp mono" id="cardCountStamp">0 CARDS</span>
      <button class="icon-btn" id="openSettingsBtn" title="Settings" aria-label="Settings">⚙</button>
    </div>
  </div>

  <!-- VIEW: NOTES -->
  <div class="app-view" id="notesView">
    <div class="notes-main">
      <div class="sidebar-scrim" id="notesSidebarScrim"></div>
      <div class="sidebar notes-sidebar" id="notesSidebar">
        <div class="sidebar-section">
          <h4>Your Notes</h4>
          <button class="btn btn-primary" id="newNoteBtn" style="width: 100%; margin-bottom: 12px;">+ New Note</button>
